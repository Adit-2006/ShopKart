# ---------------------------------------------------------------------------
# ShopKart backend environment variables (local development example).
# Copy to `backend/.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
# Render injects this automatically in production; locally it defaults to 8083.
PORT=8083

# Set to "production" on Render. Controls Secure/SameSite cookie behaviour.
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local MongoDB).
# Must include the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
dbUrl=

# Secret used to sign/verify JWT authentication tokens.
# Use a long random string. Example generator: openssl rand -hex 32
secret=

# Comma-separated list of allowed frontend origins (CORS + cookie flow).
# Local Vite dev server:
FRONTEND_URL=http://localhost:5173

# Cookie SameSite policy. Leave unset to use the safe default:
#   development -> "lax", production -> "none" (cross-site, requires HTTPS).
# Set to "lax" only if frontend and backend share the same origin.
# COOKIE_SAMESITE=none

# Razorpay keys. Required for real payments; leave blank to use the app's
# built-in test fallback (payments will not hit the live Razorpay API).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
