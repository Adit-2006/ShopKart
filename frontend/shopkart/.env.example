# ---------------------------------------------------------------------------
# ShopKart frontend environment variables.
# Copy to `frontend/shopkart/.env` for local development.
# On Vercel, set these in Project Settings -> Environment Variables.
#
# Never put secrets here: any VITE_* value is embedded in the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the ShopKart backend API (no trailing slash, no /api suffix).
# Local development:
VITE_API_URL=http://localhost:8083

# Production (Render):
# VITE_API_URL=https://<your-render-service-name>.onrender.com
